<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/redline_background">

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_splash_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/splash_mark"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_redline_mark"
            android:contentDescription="@string/app_name_full" />

        <TextView
            android:id="@+id/splash_wordmark"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.14"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/splash_sub"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.3"
            android:textColor="@color/redline_red"
            android:text="DIAGNOSTICS"
            android:contentDescription="@string/app_name_full" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="28dp"
            android:clipChildren="true">

            <View
                android:id="@+id/splash_scan_line"
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="@drawable/bg_scan_line" />
        </FrameLayout>

        <TextView
            android:id="@+id/splash_status"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_initializing" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:textColor="@color/text_disabled"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:text="@string/splash_tagline" />
    </LinearLayout>

    <TextView
        android:id="@+id/splash_version"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:textColor="@color/text_disabled" />

</FrameLayout>
